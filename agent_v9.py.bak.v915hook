    }


def load_state():
    d = default_state()
    if STATE_FILE.exists():
        try:
            old = json.loads(STATE_FILE.read_text())
            for k in d:
                if k in old:
                    d[k] = old[k]
        except Exception:
            pass
    return d


def save_state(st):
    STATE_FILE.write_text(json.dumps(st, ensure_ascii=False, indent=1))


def log_event(st, action, detail):
    LOGS.mkdir(exist_ok=True)
    row = {"ts": time.strftime("%Y-%m-%dT%H:%M:%S"), "round": st["rounds"],
           "emotions": {k: round(v, 3) for k, v in st["emotions"].items()},
           "action": action, "detail": detail}
    with open(LOGS / "events.jsonl", "a", encoding="utf-8") as f:
        f.write(json.dumps(row, ensure_ascii=False) + "\n")


def scan_workspace():
    """v9.8：同时扫描 archive 与 web（搜索结果沉淀后可回读，成为持久变异源）。"""
    files, dirs = [], []
    for root in (ARCHIVE, WEB):
        if root.exists():
            for p in root.rglob("*"):
                if p.is_file():
                    files.append({"path": str(p.relative_to(BASE)), "name": p.name,
                                  "size": p.stat().st_size, "mtime": p.stat().st_mtime,
                                  "ext": p.suffix.lower()})
                elif p.is_dir():
                    dirs.append(str(p.relative_to(BASE)))
    return files, dirs


def scan_wider(st):
    found = []
    for root in WIDER_ROOTS:
        rp = Path(root)
        if not rp.exists():
            continue
        for dirpath, dirnames, filenames in os.walk(rp):
            dirnames[:] = [d for d in dirnames if d not in BLACKLIST_DIRS and not d.startswith(".")]
            if str(BASE) in dirpath or dirpath.startswith(str(BASE)):
                continue
            for fn in filenames[:200]:
                p = Path(dirpath) / fn
                if p.suffix.lower() in WIDER_EXTS and p.stat().st_size < 200_000:
                    key = str(p)
                    if key not in st["wider_files"]:
                        st["wider_files"][key] = time.time()
                        found.append(key)
    return found


def novelty_score(files, st):
    if not files:
        return 0.0
    total = len(files)
    newish = sum(1 for f in files if time.time() - f["mtime"] < 7 * 86400)
    unseen = sum(1 for f in files if f["path"] not in st["visited_files"])
    return 0.5 * (newish / total) + 0.5 * (unseen / total)


def clamp(x, lo=0.0, hi=1.0):
    return max(lo, min(hi, x))


def update_emotions(st, action, novelty, success):
    """v9 参数化情感更新：遍历 brain/emotions.json 配置表，逐维按规则演化。
    规则字段：decay(每轮衰减) / novelty_gain(新意增益) / success_gain(成功增益)
             grow(动作增益表) / shrink(动作减损表) / shrink_other(非指定动作减损)
             extra_grow_curiosity_low(好奇心低时额外增长) / non_rest_gain(非休息增长) / rest_change(休息变化)
    情感维度增删由配置文件驱动，代码不感知具体情感名。"""
    e = st["emotions"]
    cfg = load_emotions_cfg()
    for ename, rule in cfg.items():
        cur = e.get(ename, rule.get("default", 0.0))
        if "decay" in rule:
            cur -= rule["decay"]
        if "novelty_gain" in rule:
            cur += rule["novelty_gain"] * novelty
        if "success_gain" in rule:
            cur += rule["success_gain"] * success
        if "grow" in rule:
            cur += rule["grow"].get(action, 0.0)
        if "shrink" in rule:
            cur -= rule["shrink"].get(action, 0.0)
        if "shrink_other" in rule and action not in rule.get("grow", {}):
            cur -= rule["shrink_other"]
        if "extra_grow_curiosity_low" in rule and e.get("curiosity", 0) < 0.2:
            cur += rule["extra_grow_curiosity_low"]
        if "non_rest_gain" in rule and action != "rest":
            cur += rule["non_rest_gain"]
        if "rest_change" in rule and action == "rest":
            cur += rule["rest_change"]
        e[ename] = clamp(cur, 0.0, 1.0)
    return e


def pick_action(st, e, web_built):
    """决策模型 v9：技能注册表 × 情感系数 + 学习调制 + 提问饥饿 + 枯竭切换。
    权重 = base + Σ(技能对情感维度的系数 × 情感当前值)；情感维度增删自动适配。"""
    w = {}
    for name, sk in SKILLS.items():
        wd = sk.get("weight", {})
        val = wd.get("base", 0.0)
        for key, coef in wd.items():
            if key == "base":
                continue
            if key == "curiosity_x_boredom":
                val += coef * e.get("curiosity", 0.0) * e.get("boredom", 0.0)
            else:
                val += coef * e.get(key, 0.0)
        # 条件技能：build_site 未建站时给奖金；refresh_site 需要已建站
        if name == "build_site" and not web_built:
            val += sk.get("bonus_not_built", 0.0)
        elif name == "refresh_site" and not web_built:
            val = wd.get("base", 0.05)
        w[name] = max(0.0, val)
    # ① 学习调制：动作历史成功率动态调权重（尝试≥3 次才生效）
    stats = st.get("action_stats", {})
    for a in w:
        s = stats.get(a, {"ok": 0, "try": 0})
        if s["try"] >= 3:
            rate = s["ok"] / s["try"]
            if rate >= 0.5:
                w[a] *= 1.3      # 顺手 → 更想再做
            elif rate <= 0.25 and s["try"] >= 6:
                w[a] *= 0.6      # 屡屡碰壁 → 兴趣下降
    # ② 提问饥饿：距上次提问越久越想问；从未提问过 → 保底渴望
    hunger = min(1.0, (st["rounds"] - st["last_ask_round"]) / 6.0)
    w["ask_brain"] *= 1.0 + hunger * 1.5
    if not st["brain_questions"]:
        w["ask_brain"] += 0.5
    # ③ 有未读回答时优先读（v9.2：未读时 read 权重显著提升，同时抑制提问空转——
    #    旧逻辑饥饿时 ask×2.5 > read×1.5，导致"想问但读不了"反复空转）
    unread = []
    if OUTBOX.exists():
        unread = [p for p in OUTBOX.glob("*.md") if p.stem not in st["brain_read"]]
    if unread:
        w["read_brain"] *= 1.0 + min(2.0, len(unread) * 1.2)
        w["ask_brain"] *= 0.4      # 未读未消化前，提问意愿被抑制
    # ④ v8/v9：探索枯竭时压制无效探索、抬升求知（没新文件可读 → 转而向大脑要新知识）
    if explore_starved(st):
        for a in ("explore_file", "explore_wider", "visit_new_dir"):
            w[a] *= 0.5
        w["ask_brain"] *= 1.4
    # ⑤ v9.3：web_search 冷却（距上次搜索至少 N 轮才允许；N 来自 ask_config.web_search.cooldown_rounds）
    ws = _load_ask_config().get("web_search", {})
    ws_cd = ws.get("cooldown_rounds", 40)
    last_ws = st.get("last_web_search_round", -999)
    if (st["rounds"] - last_ws) < ws_cd:
        w["web_search"] *= 0.0
    # ⑥ v9.4：情绪奖赏（Q-table 雏形）——行动的历史情绪增益调权重（样本 ≥5 才生效）
    #    与 ① 成功率学习互补：①学"好不好使"，⑥学"做起来爽不爽"
    mr = st.get("mood_reward", {})
    for a in w:
        m = mr.get(a)
        if m and m["n"] >= 5:
            avg = (m["sat_sum"] + m["cur_sum"]) / m["n"]
            if avg > 0.05:
                w[a] *= 1.0 + min(0.3, avg)      # 做过就爽 → 更想再做
            elif avg < -0.05:
                w[a] *= max(0.5, 1.0 - min(0.25, -avg))   # 做过就烦 → 兴趣下降
    # ⑦ v9.7：昼夜节律——白天偏向探索/提问/搜索/产出，夜间偏向休息/整理/巩固
    df = day_factor()
    for a in ("explore_file", "explore_wider", "visit_new_dir", "web_search", "ask_brain", "build_site", "refresh_site"):
        w[a] *= df
    for a in ("rest", "tidy_notes", "consolidate_memory", "reflect_memory"):
        w[a] *= 1.5 - df
    # ⑧ v9.7：能量内稳态——饿（energy 低）时 rest/求食(探索) 权重抬升、fear 生效
    en = st.get("energy", 1.0)
    if en < 0.35:
        w["explore_file"] *= 1.6
        w["ask_brain"] *= 1.5
        w["rest"] *= 1.8
        w["tidy_notes"] *= 0.4
        w["refresh_site"] *= 0.4
    # ⑨ v9.8b：渴求度机制——低频重要动作越久未触发权重越强（累加→超阈值翻倍）
    #    参数在 ask_config.json 的 urge 段（可外围调优/agent 自行提"帮我改"调整）：
    #    enabled/increment(每轮累加量)/cap(上限)/double_threshold(翻倍起轮)/double_base(翻倍系数)
    urge_cfg = _load_ask_config().get("urge", {})
    if urge_cfg.get("enabled", True):
        urge_acts = urge_cfg.get("actions", ["reflect_memory", "consolidate_memory"])
        for a in urge_acts:
            u = st.get("urge", {}).get(a, 0)
            if u <= 0:
                continue
            th = urge_cfg.get("double_threshold", 6)
            if u >= th:
                w[a] *= (urge_cfg.get("double_base", 1.5) ** u)          # 超阈值：指数翻倍
            else:
                w[a] *= (1.0 + u * urge_cfg.get("linear_factor", 0.2))   # 未超阈值：线性累加
    # ⑩ v9.14 学习进展 LP（Oudeyer 发展机器人学）：最近主题误差下降=学得动→继续深挖；
    #    误差不降=学不动/已掌握→抬升求知/搜索，转向新区域（"何时停止学一件事"的判据）
    if st.get("lp"):
        _latest = sorted(st["lp"].values(), key=lambda x: -x.get("last_round", 0))[0]
        if len(_latest.get("err_history", [])) >= 2:
            _lp = _latest.get("lp", 0.0)
            if _lp > 0.05:
                w["explore_file"] *= 1.2
                w["explore_wider"] *= 1.1
            elif _lp < -0.05:
                w["ask_brain"] *= 1.2
                w["web_search"] *= 1.1
    names = list(w.keys())
    return random.choices(names, weights=[w[n] for n in names], k=1)[0]


def read_head(path, n=20):
    try:
        with open(path, encoding="utf-8", errors="ignore") as f:
            return [l.rstrip() for l in f.readlines()[:n]]
    except Exception:
        return []


def read_full(path, max_chars=sem.MAX_CHARS):
    """v6：读全文（截断到上限字符）供语义化。"""
    try:
        with open(path, encoding="utf-8", errors="ignore") as f:
            return f.read(max_chars)
    except Exception:
        return ""


def semantic_note(full_text, path, top, kind="text"):
    """v7：全文 → kb 记忆库入库。
    v9.10：关闭 kb 联想（embedding 训练数据相关性），只存放记忆；
    记忆相关性由 agent 自身自组织关系网发现（co_occur/similar/causal）。
    返回 (联想笔记文本, relate 摘要)。"""
    tags = [t for t in top.split("、") if t][:6]
    kb_ok = kb_remember(full_text, tags, str(path))
    relate = f"记忆已存放（{'kb' if kb_ok else 'kb暂不可用，本地笔记' }）"
    note = f"\n- 语义记忆：{relate}"
    return note, relate


def append_note(st, text):
    NOTES.mkdir(parents=True, exist_ok=True)
    with open(NOTES / "journey.md", "a", encoding="utf-8") as f:
        f.write(text + "\n")
    st["note_lines"] += 1


def do_explore_file(files, st):
    unseen = [f for f in files if f["path"] not in st["visited_files"]]
    pool = unseen if unseen else files
    if not pool:
        return False, "无文件可读"
    f = random.choice(pool)
    full = read_full(BASE / f["path"])
    lines = full.splitlines()
    title = lines[0][:60] if lines else f["name"]
    words = Counter(re.findall(r"[\u4e00-\u9fa5]{2,}", " ".join(lines[:40])))
    top = "、".join(w for w, _ in words.most_common(8)) or "无"
    note, relate = semantic_note(full, BASE / f["path"], top)
    st["last_kw"] = top   # v9.6：语义中心缓存（内容高频词），供提问/搜索主题
    # v9.8c 预测机制：读前按文件名×已有概念生成预期主题，读后核对，误差进记忆
    _pc = _load_ask_config().get("predict", {})
    _pk = int(_pc.get("topk", 3))
    _concepts = set(st.get("concepts", {}).keys())
    _expect = []
    for _w in re.findall(r"[\u4e00-\u9fa5]{2,}", f["name"]):
        for _c in _concepts:
            if _c in _w or _w in _c:
                _expect.append(_c)
    _expect = list(dict.fromkeys(_expect))[:_pk]
    _actual = [w for w, _ in words.most_common(8)]
    _hit = [c for c in _expect if c in _actual]
    _miss = [c for c in _expect if c not in _actual]
    _surprise = [w for w in _actual if w not in _expect and w in _concepts][:3]
    # v9.15 分层预测：粗猜主题类别 → 再细猜具体符号
    # 粗层：根据文件名/已有概念，猜这篇大概讲哪类
    _fn = f["name"]
    _coarse_guess = []
    if any(n in _fn for n in ("数", "加", "算", "字", "后继", "概率")):
        _coarse_guess.append("数字/加法")
    if any(w in _fn for w in ("天", "温", "风", "天气")):
        _coarse_guess.append("天气")
    if any(l in _fn for l in ("信号", "语言", "符号", "人工")):
        _coarse_guess.append("语言/信号")
    if not _coarse_guess:
        _coarse_guess.append("其他")
    # 细层：实际关键词里有没有粗类别的影子
    _coarse_hit = any(
        (c == "数字/加法" and any(re.search(r"[一二三四五六七八九十加等于]", " ".join(_actual))) or
         c == "天气" and any(w in " ".join(_actual) for w in ("温度", "天", "风")) or
         c == "语言/信号" and any(w in " ".join(_actual) for w in ("信号", "语言", "符号")))
        for c in _coarse_guess)
    _pl = st.setdefault("pred_log", [])
    _pl.append({"round": st["rounds"], "file": f["name"], "expect": _expect,
                "hit": _hit, "miss": _miss, "surprise": _surprise})
    del _pl[:max(0, len(_pl) - int(_pc.get("log_size", 50)))]
    if _expect:
        append_note(st, f"预测核对：预期{','.join(_expect) or '无'}｜命中{','.join(_hit) or '无'}｜未兑现{','.join(_miss) or '无'}｜意外{','.join(_surprise) or '无'}｜粗猜类别{','.join(_coarse_guess)}{'命中' if _coarse_hit else '未命中'}")
    # v9.15 分层预测记录
    st.setdefault("pred_layers", []).append({
        "round": st["rounds"], "file": f["name"],
        "coarse": _coarse_guess, "coarse_hit": _coarse_hit,
        "fine_expect": _expect, "fine_surprise": _surprise})
    del st["pred_layers"][-50:]
    # v9.9 注意过滤行为化：web 文件 surprise 全为格式词 → 低价值，跳过概念/规则学习（不污染概念库）
    _low_value = ("web-" in f["path"] and _surprise
                  and all(w in _FORMAT_NOISE for w in _surprise))
    _pl[-1]["low_value"] = _low_value
    # v9.14 学习进展 LP（Oudeyer）：主题误差率（surprise 占比）历史；
    # LP=前半均值−后半均值：误差下降=学得动（正进展），误差不降=学不动/已掌握
    _lp_map = st.setdefault("lp", {})
    _topic_lp = (st.get("last_kw") or "").split("、")[0] or f["name"]
    _err = len(_surprise) / max(1, len(_actual))
    _rec = _lp_map.setdefault(_topic_lp, {"err_history": [], "lp": 0.0, "last_round": 0})
    _rec["err_history"].append(round(_err, 3))
    del _rec["err_history"][:-4]
    _h = _rec["err_history"]
    if len(_h) >= 2:
        _k = max(1, len(_h) // 2)
        _rec["lp"] = round(sum(_h[:_k]) / _k - sum(_h[_k:]) / len(_h[_k:]), 3)
    _rec["last_round"] = st["rounds"]
    if len(_lp_map) > 20:
        for _oldk in sorted(_lp_map, key=lambda k: _lp_map[k]["last_round"])[:-20]:
            del _lp_map[_oldk]
    if _low_value:
        append_note(st, f"低价值跳过学习：{f['name']}（surprise全为格式噪声：{','.join(_surprise)}）")
    else:
        learn_from_text(st, full, Path(f["name"]).stem, f["name"])   # v9.7：概念/关系/规则学习
    append_note(st, f"## 读到：{f['name']}\n- 首行：{title}\n- 关键词：{top}{note}")
    if f["path"] not in st["visited_files"]:
        st["visited_files"].append(f["path"])
    return True, f"读了 {f['name']}（{len(lines)} 行，关键词：{top}，{relate}）"


def do_explore_wider(st):
    found = scan_wider(st)
    if not found:
        return False, "更大范围没有新文本文件"
    key = random.choice(found)
    try:
        full = read_full(key)
        lines = full.splitlines()
        words = Counter(re.findall(r"[\u4e00-\u9fa5]{2,}|[a-zA-Z]{4,}", " ".join(lines[:40])))
        top = "、".join(w for w, _ in words.most_common(8)) or "无"
        note, relate = semantic_note(full, key, top)
        st["last_kw"] = top   # v9.6：语义中心缓存
        learn_from_text(st, full, Path(key).stem, key)   # v9.7：关系学习
        append_note(st, f"## 探到外部文件：{key}\n- 首行：{lines[0][:60] if lines else ''}\n- 关键词：{top}{note}")
        return True, f"读了外部文件 {Path(key).name}（{len(lines)} 行，关键词：{top}，{relate}）"
    except Exception as exc:
        return False, f"读取失败：{exc}"


def do_visit_new_dir(dirs, st):
    unseen = [d for d in dirs if d not in st["visited_dirs"]]
    if not unseen:
        return False, "目录都看过了"
    d = random.choice(unseen)
    p = BASE / d
    names = [x.name for x in p.iterdir() if not x.name.startswith(".")][:8]
    append_note(st, f"## 探访目录：{d}\n- 发现：{len(names)} 个条目：{'、'.join(names[:5])}")
    st["visited_dirs"].append(d)
    return True, f"探访新目录 {d}（发现 {len(names)} 个条目）"


def do_tidy_notes(st):
    NOTES.mkdir(parents=True, exist_ok=True)
    notes_file = NOTES / "journey.md"
    if notes_file.exists():
        text = notes_file.read_text(encoding="utf-8")
        words = Counter(re.findall(r"[\u4e00-\u9fa5]{2,}", text))
        top = "、".join(w for w, _ in words.most_common(10))
    else:
        top = "暂无笔记"
    with open(NOTES / "index.md", "w", encoding="utf-8") as f:
        f.write(f"# 探索索引（第 {st['rounds']} 轮）\n高频词：{top}\n已读 {len(st['visited_files'])} 个文件\n")
    # 顺带整理模板库（低频淘汰）
    removed = prune_templates(st)
    extra = f"，模板库淘汰 {removed} 个低频模板" if removed else ""
    return True, f"整理笔记（高频词：{top[:40]}）{extra}"


def do_ask_brain(st):
    """写一个问题到 inbox.md（节流：至少隔 3 轮，且无未读回答）。
    v8：双通道提问——
      A) 模板通道：从可插拔模板库选取，{topic} 填最近读过的文件名（确认型）
      B) 开放求知通道：不绑已读文件，直接向大脑索要记忆库外的新知识（求知型）
    当探索枯竭（没新文件可读）或提问饥饿度高时，求知通道权重提升——
    大脑是它的"外部信息获取媒介"，文件读完了就主动去要新知识，而不是空转休息。"""
    if st["rounds"] - st["last_ask_round"] < 3:
        return False, "提问节流中（距上次提问不足 3 轮）"
    OUTBOX.mkdir(parents=True, exist_ok=True)
    unread = [p for p in OUTBOX.glob("*.md") if p.stem not in st["brain_read"]]
    if unread:
        return False, "已有未读回答，先读再问"

    qid = time.strftime("Q-%Y%m%d-%H%M")
    if qid in st["brain_questions"]:
        return False, "本分钟已提问"

    topic = ""
    # v9.6：语义中心优先——最近读文件的内容高频词（首个词≤12字），回退文件名
    kw = st.get("last_kw", "")
    if kw and kw != "无":
        topic = kw.split("、")[0][:12]
    elif st["visited_files"]:
        topic = Path(st["visited_files"][-1]).name

    # ---- v9.12 变换猜想通道（组合泛化，优先于图激活推理）----
    # 用已知 transforms 做符号归约，推出未见过的加法表达式，再请大脑判定；
    # 判真后由 read_brain 回写为新 transform（演绎→验证→习得闭环）。
    if (st["rounds"] - st.get("last_infer_round", -999)) >= 20:
        tc = transform_compose(st)
        if tc:
            expr_t, result_t, via_t = tc
            st["last_infer_round"] = st["rounds"]
            question = (f"我用记忆里的加法变换做了一次组合推导：{via_t}，"
                        f"所以我推出『{expr_t}等于{result_t}』——这是我推理出的未知联系。"
                        f"请判断这个推理对不对（请在回答开头写 [VERDICT:真] 或 [VERDICT:假] 或 [VERDICT:存疑]）。")
            source = f"变换组合通道（{expr_t}→{result_t}）"
            st.setdefault("infer_log", []).append(
                {"qid": qid, "premises": [expr_t], "result": result_t,
                 "round": st["rounds"], "type": "transform"})
            _il = st["infer_log"]
            del _il[:max(0, len(_il) - 50)]
            BRAIN.mkdir(parents=True, exist_ok=True)
            with open(INBOX, "a", encoding="utf-8") as f:
                f.write(f"[{qid}] {question}\n")
            st["brain_questions"].append(qid)
            st["last_ask_round"] = st["rounds"]
            return True, f"已向大脑提问 [{qid}]（来自{source}）：{question}"

    # ---- v9.7 推理通道：概念网激活扩散（A+C→未知D），冷却20轮，优先于求知 ----
    if (st["rounds"] - st.get("last_infer_round", -999)) >= 20 and topic:
        inf = infer_from_graph(st, topic)
        if inf:
            A, C, D, strength = inf
            st["last_infer_round"] = st["rounds"]
            question = (f"我最近读的《{A}》让我联想到《{C}》，在我的记忆里两者都和《{D}》相连。"
                        f"我推断《{A}》和《{C}》一起出现时，可能会涉及《{D}》——这是我推理出的未知联系。"
                        f"请判断这个推理对不对（请在回答开头写 [VERDICT:真] 或 [VERDICT:假] 或 [VERDICT:存疑]）。")
            source = f"推理通道（{A}+{C}→{D}，强度{strength}）"
            st.setdefault("infer_log", []).append(
                {"qid": qid, "premises": [A, C], "result": D, "round": st["rounds"]})
            _il = st["infer_log"]
            del _il[:max(0, len(_il) - 50)]
            BRAIN.mkdir(parents=True, exist_ok=True)
            with open(INBOX, "a", encoding="utf-8") as f:
                f.write(f"[{qid}] {question}\n")
            st["brain_questions"].append(qid)
            st["last_ask_round"] = st["rounds"]
            return True, f"已向大脑提问 [{qid}]（来自{source}）：{question}"

    # ---- v8 开放求知判定（v9.1 参数化：brain/ask_config.json 可外围调优）----
    # 默认值=旧行为（缺失配置时完全回退），删配置即回滚。
    starved = explore_starved(st)                     # 探索枯竭：最近探索频频扑空
    hungry = (st["rounds"] - st["last_ask_round"]) >= 6   # 提问饥饿
    roll = random.random()
    oa = _load_ask_config().get("open_ask", {})
    starved_force = oa.get("starved_force", True)     # 枯竭必开（探索真枯竭时需要外部输入）
    starved_prob  = oa.get("starved_prob", 1.0)
    hungry_force  = oa.get("hungry_force", True)      # 饥饿必开（旧行为）
    hungry_prob   = oa.get("hungry_prob", 1.0)
    random_prob   = oa.get("random_prob", 0.35)       # 普通轮随机开放概率
    cooldown      = oa.get("cooldown_rounds", 0)      # 距上次开放求知至少间隔 N 轮
    max_consec    = oa.get("max_consecutive", 99)     # 连续开放求知上限，超标转模板通道
    go_open = False
    last_open = st.get("last_open_ask_round", -999)
    if (st["rounds"] - last_open) >= cooldown:        # 冷却内不开放求知
        if starved and starved_force:
            go_open = True
        elif starved:
            go_open = roll < starved_prob
        elif hungry and hungry_force:
            go_open = True
        elif hungry:
            go_open = roll < hungry_prob
        else:
            go_open = roll < random_prob
    if go_open:
        # 连续抑制：12 轮内再次开放 → streak+1，超 max_consec 则本轮转模板通道
        streak = st.get("open_streak", 0)
        if (st["rounds"] - last_open) > 12:
            streak = 1
        else:
            streak += 1
        st["open_streak"] = streak
        if streak > max_consec:
            go_open = False
    if go_open:
        st["last_open_ask_round"] = st["rounds"]
        st["open_asks"] = st.get("open_asks", 0) + 1
        source = f"开放求知（starved={starved},hungry={hungry},roll={roll:.2f},streak={streak}）"
        if topic:
            question = (f"我想学点新东西：请讲一件我记忆库里没有的新知识，"
                        f"最好和我最近读的《{topic}》有关，或能帮我理解它的反面或盲区。")
        else:
            question = "我想学点新东西：请讲一件我记忆库里没有的新知识，并说说它为什么值得了解。"
    else:
        # ---- 模板通道（原 v7 逻辑）----
        templates = load_templates()
        if templates:
            # v9.8：低频优先加权抽取——按已用次数倒权，过热模板自然降温（t0001 曾 11 次过热）
            uses = st.get("template_uses", {})
            tids = [t for t, _ in templates]
            weights = [1.0 / (1.0 + uses.get(tid, 0)) for tid, _ in templates]
            tpl_id, tpl_text = random.choices(templates, weights=weights, k=1)[0]
            st["template_uses"][tpl_id] = st["template_uses"].get(tpl_id, 0) + 1
            source = f"模板库[{tpl_id}]"
        else:
            tpl_text = random.choice(SEED_TEMPLATES)
            source = "种子模板"
        question = tpl_text.replace("{topic}", topic or "这些资料")
        if not question.strip():
            question = random.choice(SEED_TEMPLATES).replace("{topic}", topic or "这些资料")

        # v9.5：记录模板→问题映射，供 Ratchet 式退役判定（提问后 6 轮无果 → 计一次）
        if templates:
            st.setdefault("tpl_pending", {})[qid] = {"tpl": tpl_id, "round": st["rounds"]}
    BRAIN.mkdir(parents=True, exist_ok=True)
    with open(INBOX, "a", encoding="utf-8") as f:
        f.write(f"[{qid}] {question}\n")
    st["brain_questions"].append(qid)
    st["last_ask_round"] = st["rounds"]
    return True, f"已向大脑提问 [{qid}]（来自{source}）：{question}"


def explore_starved(st):
    """探索枯竭检测：最近探索动作频频扑空（成功率 <20% 且尝试 ≥4 次）→ True。
    基于 action_stats 的成功率，不读日志，纯状态判断。"""
    stats = st.get("action_stats", {})
    s = stats.get("explore_file", {"ok": 0, "try": 0})
    w = stats.get("explore_wider", {"ok": 0, "try": 0})
    tot, okc = s["try"] + w["try"], s["ok"] + w["ok"]
    return tot >= 4 and (okc / tot) < 0.2


def _load_ask_config():
    """读开放求知触发配置（brain/ask_config.json）。失败返回 {}（触发默认旧行为）。"""
    try:
        with open(BRAIN / "ask_config.json", "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {}


def load_templates():
    """读模板库：返回 [(模板id, 模板文本)]，按文件名排序保证稳定。
    v9.5：retired/ 子目录内的退役模板不再参与（可恢复）。"""
    if not TEMPLATES_DIR.exists():
        return []
    items = []
    for p in sorted(TEMPLATES_DIR.glob("*.txt")):
        try:
            text = p.read_text(encoding="utf-8").strip()
        except Exception:
            continue
        if text:
            items.append((p.stem, text))
    return items


def check_template_retirement(st):
    """v9.5 Ratchet 式模板退役：模板通道提问后 6 轮未读到回答 → 无果+1；
    累计 4 次无果 → 模板退役（移入 templates/retired/，可恢复）。"""
    pending = st.get("tpl_pending", {})
    if not pending:
        return
    now = st["rounds"]
    expired = [q for q, info in pending.items() if now - info.get("round", 0) > 6]
    for q in expired:
        info = pending.pop(q)
        tid = info.get("tpl")
        if not tid:
            continue
        tf = st.setdefault("template_failures", {})
        tf[tid] = tf.get(tid, 0) + 1
        if tf[tid] >= 4:
            tpl_file = TEMPLATES_DIR / f"{tid}.txt"
            if tpl_file.exists():
                retired_dir = TEMPLATES_DIR / "retired"
                retired_dir.mkdir(exist_ok=True)
                try:
                    tpl_file.rename(retired_dir / f"{tid}.txt")
                    append_note(st, f"- 模板 [{tid}] 退役：连续 {tf[tid]} 次提问无果，移入 retired/（可恢复）")
                    tf.pop(tid, None)   # 退役后不再计数
                except Exception:
                    pass


def save_template(text):
    """把新模板写入模板库（去重后）。返回 (是否新增, 模板id)。"""
    text = text.strip()
    if not text or len(text) > 200:
        return False, None
    TEMPLATES_DIR.mkdir(parents=True, exist_ok=True)
    existing = load_templates()
    norm = text.replace(" ", "").replace("\n", "")
    for _, t in existing:
        if t.replace(" ", "").replace("\n", "") == norm:
            return False, None
    idx = len(existing) + 1
    tpl_id = f"t{idx:04d}"
    # 避开已存在的 id
    used = {tid for tid, _ in existing}
    while tpl_id in used:
        idx += 1
        tpl_id = f"t{idx:04d}"
    (TEMPLATES_DIR / f"{tpl_id}.txt").write_text(text, encoding="utf-8")
    return True, tpl_id


def extract_templates(text):
    """从大脑回答中提取 [TEMPLATE]...[/TEMPLATE] 标记块。"""
    return re.findall(r"\[TEMPLATE\]\s*(.*?)\s*\[/TEMPLATE\]", text, re.S)


def prune_templates(st):
    """模板库演化：容量超限时淘汰低频旧模板，保留最近入库的。"""
    if st["rounds"] - st["template_prune_round"] < PRUNE_EVERY:
        return 0
    st["template_prune_round"] = st["rounds"]
    items = load_templates()
    if len(items) <= TEMPLATE_MAX:
        return 0
    # 排序：使用次数升序（没用过排最前），同频次按 id（入库时间）升序
    def key(item):
        tid, _ = item
        return (st["template_uses"].get(tid, 0), tid)
    items.sort(key=key)
    removed = 0
    for tid, _ in items[:-PRUNE_KEEP_MIN]:
        p = TEMPLATES_DIR / f"{tid}.txt"
        if p.exists():
            p.unlink()
            st["template_uses"].pop(tid, None)
            removed += 1
        if len(items) - removed <= TEMPLATE_MAX:
            break
    return removed


# 搜索主题词黑名单（避免搜索词滑向危险/低质领域）
SEARCH_BLACK_WORDS = {"密码", "爆破", "入侵", "漏洞", "赌博", "色情", "毒品", "武器", "黑客"}


def _pick_search_topic(st):
    """搜索主题词来源：v9.6 优先最近读文件的语义中心（内容高频词，≤24字），其次文件名，再回退 journey 尾部词。"""
    kw = st.get("last_kw", "")
    if kw and kw != "无":
        t = kw.split("、")[0][:24]
        if t:
            return t
    if st["visited_files"]:
        t = Path(st["visited_files"][-1]).name
        t = re.sub(r"\.[A-Za-z0-9]+$", "", t)
        if t and len(t) <= 24:
            return t
    jf = NOTES / "journey.md"
    if jf.exists():
        for line in reversed(jf.read_text(encoding="utf-8", errors="ignore").splitlines()):
            line = line.strip()
            if line.startswith(("##", "- 语义联想")):
                continue
            words = re.findall(r"[\u4e00-\u9fff]{2,8}", line)
            if words:
                return words[-1][:24]
    return "涌现"


def do_web_search(st):
    """v9.3：上网搜索（无 LLM 关键词级）。
    - 用 Bing 搜索接口抓取主题词的结果标题+摘要纯文本，写 workspace/web/web-*.md
    - 结果语义入库 kb（联想旧记忆），失败静默降级（网络不稳不惩罚）
    - 冷却在 pick_action ⑤ 控制；参数在 ask_config.json 的 web_search 段"""
    ws = _load_ask_config().get("web_search", {})
    if not ws.get("enabled", True):
        return False, "web_search 已禁用"
    topic = _pick_search_topic(st)
    if any(bw in topic for bw in SEARCH_BLACK_WORDS):
        return False, "搜索词含黑名单词，已跳过"
    top_k = int(ws.get("top_k", 5))
    query = urllib.parse.quote(topic)
    url = f"https://cn.bing.com/search?q={query}&setlang=zh-hans"
    try:
        req = urllib.request.Request(url, headers={
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
            "Accept-Language": "zh-CN,zh;q=0.9",
        })
        with urllib.request.urlopen(req, timeout=15) as r:
            html = r.read().decode("utf-8", errors="ignore")
    except Exception as exc:
        return False, f"搜索失败（{exc.__class__.__name__}），静默降级"
    results = []
    for m in re.finditer(r'<li class="b_algo".*?</li>', html, re.S):
        block = m.group(0)
        hm = re.search(r'<h2[^>]*>\s*<a[^>]*href="([^"]+)"[^>]*>(.*?)</a>', block, re.S)
        if not hm:
            continue
        link, title = hm.group(1), re.sub(r"<[^>]+>", "", hm.group(2)).strip()
        pm = re.search(r"<p[^>]*>(.*?)</p>", block, re.S)
        snippet = re.sub(r"<[^>]+>", "", pm.group(1)).strip() if pm else ""
        if title:
            results.append((title[:80], snippet[:200], link[:200]))
        if len(results) >= top_k:
            break
    if not results:
        return False, f"搜索「{topic}」无可用结果"
    WEB.mkdir(parents=True, exist_ok=True)
    stamp = time.strftime("web-%Y%m%d-%H%M")
    lines = [f"## 网络搜索 [{stamp}] 主题：{topic}", ""]
    for i, (title, snippet, link) in enumerate(results, 1):
        lines.append(f"{i}. {title}")
        if snippet:
            lines.append(f"   摘要：{snippet}")
        lines.append(f"   来源：{link}")
    text = "\n".join(lines)
    (WEB / f"{stamp}.md").write_text(text, encoding="utf-8")
    note, relate = semantic_note(text, f"workspace/web/{stamp}.md", topic, kind="web")
    append_note(st, f"## 网络搜索 [{stamp}] 主题「{topic}」\n{text[:600]}\n- 语义联想：{relate}")
    st["last_web_search_round"] = st["rounds"]
    return True, f"网络搜索「{topic}」抓到 {len(results)} 条结果并入库"


def do_read_brain(st):
    """读 outbox 里未读的回答：整篇写入笔记，并提取 [TEMPLATE] 标记入模板库。"""
    OUTBOX.mkdir(parents=True, exist_ok=True)
    read_any = False
    new_tpl = 0
    for p in sorted(OUTBOX.glob("*.md")):
        if p.stem in st["brain_read"]:
            continue
        try:
            text = p.read_text(encoding="utf-8").strip()
        except Exception:
            continue
        append_note(st, f"## 大脑回答 [{p.stem}]\n{text[:800]}")
        # v6：回答也语义化，知道"这份回答在讲什么/和什么最相关"
        top_kw = "大脑回答"
        note, relate = semantic_note(text, f"brain/outbox/{p.stem}.md", top_kw, kind="answer")
        append_note(st, f"- 语义联想：{relate}")
        # v9.10 消化升级：相关性由自身概念库判定（不再用 kb embedding 训练数据）
        try:
            _ans_words = set(re.findall(r"[\u4e00-\u9fa5]{2,6}", text[:300])) - _FORMAT_NOISE
            _hit_self = _ans_words & set(st.get("concepts", {}).keys())
            if len(_hit_self) >= 2:
                append_note(st, f"- 消化标注：内容命中自身概念库 {len(_hit_self)} 个（{'、'.join(list(_hit_self)[:4])}），与已有知识网络相关（自组织判定）")
            else:
                append_note(st, f"- 消化标注：自身概念库命中 {len(_hit_self)} 个（<2），视为新知识边界")
        except Exception:
            append_note(st, "- 消化标注：已消化")
        # 从回答中提取新提问模板 → 可插拔模板库自增长
        for tpl in extract_templates(text):
            added, tpl_id = save_template(tpl)
            if added:
                new_tpl += 1
                append_note(st, f"- 从大脑回答学到新模板 [{tpl_id}]：{tpl[:60]}")
        # v9.5：该问题有果 → 模板失败计数清零（若它来自模板通道）
        pending = st.get("tpl_pending", {})
        if p.stem in pending:
            tid = pending.pop(p.stem).get("tpl")
            if tid:
                st.setdefault("template_failures", {}).pop(tid, None)
        # v9.7：推理验证回写——大脑回答开头带 [VERDICT:真/假/存疑] 时更新推理记忆
        verdict = None
        for v in ("真", "假", "存疑"):
            if text.startswith(f"[VERDICT:{v}]"):
                verdict = v
                break
        if verdict:
            for il in st.get("infer_log", []):
                if il.get("qid") == p.stem and "verdict" not in il:
                    il["verdict"] = verdict
                    if il.get("type") == "transform":
                        # v9.12 变换组合猜想：判真→注册为新 transform（演绎→验证→习得闭环）
                        expr_t = il["premises"][0]
                        Dt = il.get("result")
                        if verdict == "真" and Dt:
                            tfs = st.setdefault("transforms", {})
                            tkey = expr_t + "→" + Dt
                            if tkey not in tfs:
                                tfs[tkey] = {
                                    "operands": re.findall(r"[一二三四五六七八九十]+", expr_t),
                                    "result": Dt, "support": 1, "last": st["rounds"],
                                    "source": "composed"}
                                append_note(st, f"- 变换习得：组合推导 {expr_t}={Dt} 判真，已注册为新变换")
                        append_note(st, f"- 推理验证：{expr_t}→{Dt} 被大脑判定为『{verdict}』")
                        break
                    A, C = il["premises"]
                    D = il.get("result")
                    if verdict == "真" and D:
                        cc = st.setdefault("concepts", {}).setdefault(D, {"n": 0, "last": 0})
                        cc["n"] += 1
                        for k in list(st.get("relations", {}).keys()):
                            if D in k.split("|"):
                                st["relations"][k]["w"] += 1
                    elif verdict == "假":
                        ak = "|".join(sorted([A, C]))
                        if ak in st.get("relations", {}):
                            st["relations"][ak]["w"] = max(0, st["relations"][ak]["w"] - 1)
                        # v9.14 错误记忆：记录前提组合（裁剪 30 条），infer_from_graph 避开
                        _mk = st.setdefault("mistakes", [])
                        _mk.append({"round": st["rounds"], "premises": [A, C],
                                    "pattern": sorted([A, C]), "result": D})
                        del _mk[:-30]
                    append_note(st, f"- 推理验证：{A}+{C}→{D if D else '?'} 被大脑判定为『{verdict}』")
                    break
        # v9.7：只对大脑回答（Q-）做关系学习——FEED 投喂指示是提示性文本，不产生概念/规则
        if p.stem.startswith("Q-") or p.stem.startswith("FEED-"):
            learn_from_text(st, text[:800], p.stem, p.stem)
        st["brain_read"].append(p.stem)
        read_any = True
    if not read_any:
        return False, "没有新回答"
    extra = f"，并新增 {new_tpl} 个提问模板" if new_tpl else ""
    return True, f"读到 {len([x for x in st['brain_read'] if x.startswith('Q-')])} 条大脑回答并记入笔记{extra}"


def build_site(st):
    WEB.mkdir(parents=True, exist_ok=True)
    emo = {k: round(v, 2) for k, v in st["emotions"].items()}
    notes_text = ""
    jf = NOTES / "journey.md"
    if jf.exists():
        notes_text = jf.read_text(encoding="utf-8")[:4000]

    files_list = ""
    if ARCHIVE.exists():
        files_list = "".join(f"<li>{p.relative_to(ARCHIVE)}</li>" for p in ARCHIVE.rglob("*") if p.is_file())

    html = f"""<!DOCTYPE html>
<html lang="zh"><head><meta charset="utf-8">
<title>selfdrive agent 探索站</title>
<style>
body{{font-family:monospace;max-width:720px;margin:40px auto;padding:0 16px;color:#222;background:#fff}}
h1{{border-bottom:2px solid #000;padding-bottom:8px}}
.box{{border:1px solid #000;padding:12px;margin:14px 0}}
li{{margin:4px 0}}
</style></head><body>
<h1>selfdrive agent 探索站</h1>
<p>第 {st['rounds']} 轮 · 情感：好奇 {emo['curiosity']} · 无聊 {emo['boredom']} · 满足 {emo['satisfaction']} · 疲劳 {emo['fatigue']}</p>
<div class="box"><b>探索统计</b><ul>
<li>已读文件：{len(st['visited_files'])}</li>
<li>外部文件发现：{len(st['wider_files'])}</li>
<li>笔记行数：{st['note_lines']}</li>
<li>网页刷新：{st['web_refreshes']}</li>
<li>已提问题：{len(st['brain_questions'])}</li>
<li>已读回答：{len([x for x in st['brain_read'] if x.startswith('Q-')])}</li>
</ul></div>
<div class="box"><b>口粮资料</b><ul>{files_list or '<li>无</li>'}</ul></div>
<div class="box"><b>探索日记</b><pre>{notes_text}</pre></div>
</body></html>"""
    (WEB / "index.html").write_text(html, encoding="utf-8")
    st["web_built"] = True

    if not server_running():
        try:
            log_f = open(LOGS / "http.log", "a")
            subprocess.Popen(["python3", "-m", "http.server", "8000", "--directory", str(WEB)],
                             stdout=log_f, stderr=log_f, start_new_session=True)
        except Exception as exc:
            return True, f"网站已生成但服务启动失败：{exc}"
    return True, "网站已部署（index.html + http.server:8000）"


def refresh_site(st):
    st["web_refreshes"] += 1
    return build_site(st)


def server_running():
    try:
        out = subprocess.run(["pgrep", "-f", "http.server 8000"], capture_output=True, text=True, timeout=5)
        return bool(out.stdout.strip())
    except Exception:
        return False


def do_rest(st):
    return True, "休息一轮（疲劳下降）"


# ================= v9.7：内稳态 / 关系学习 / 推理 / 记忆巩固 =================

def day_factor():
    """昼夜节律相位：6:00-20:00 为白天（1.0），夜间 0.4。"""
    h = time.localtime().tm_hour
    return 1.0 if 6 <= h < 20 else 0.4


def apply_energy(st, action, ok):
    """内稳态：动作耗能/回能，能量低→恐惧上升（求生动机，不会死亡）。"""
    en = st.setdefault("energy", 1.0)
    en -= 0.008  # 基础代谢
    gains = {"explore_file": 0.06, "explore_wider": 0.06, "read_brain": 0.05,
             "web_search": 0.05, "consolidate_memory": 0.03, "rest": 0.08,
             "reflect_memory": 0.02,   # v9.8 辉月：回想记忆小幅回能（自我滋养）
             "ask_brain": -0.02, "tidy_notes": -0.01, "refresh_site": -0.01}
    g = gains.get(action, 0.0)
    if ok:
        en += g
    st["energy"] = max(0.0, min(1.0, en))
    e = st.setdefault("emotions", {})
    fear = e.get("fear", 0.0)
    if st["energy"] < 0.35:
        fear = min(1.0, fear + 0.12)   # 饿→怕→被迫行动
    elif st["energy"] > 0.7:
        fear = max(0.0, fear - 0.05)
    e["fear"] = round(fear, 4)


def learn_from_text(st, text, title, source):
    """v9.7 关系学习：概念计数 + 同现加边（Hebb）+ 规则归纳（A∧B→C）。
    只取资料前 600 字的中文 2-4 字词，避免概念爆炸。"""
    if not text or len(text) < 20:
        return 0, 0, 0
    words = Counter(re.findall(r"[\u4e00-\u9fa5]{2,6}", text[:600]))
    top = [w for w, _ in words.most_common(10) if w != title and w not in _FORMAT_NOISE][:4]
    if len(top) < 2:
        return 0, 0, 0
    cons = st.setdefault("concepts", {})
    rels = st.setdefault("relations", {})
    # v9.11 数字加法句式识别（owner 授权 2026-10-23）：
    # 识别 "X加Y加…等于Z"（操作数为中文数字），注册干净表达式概念 +
    # transforms 变换边（表达式→结果）+ 表达式与结果的结构边。
    # 不改分词正则、不动推理主体，只加建边逻辑，可回滚。
    _NUM = "一二三四五六七八九十"
    for m in re.finditer(r"([%s]+(?:加[%s]+)+)等于([%s]+)" % (_NUM, _NUM, _NUM), text[:600]):
        expr, res = m.group(1), m.group(2)
        ops = re.findall(r"[%s]+" % _NUM, expr)
        cons.setdefault(res, {"n": 0, "last": 0})
        cons[res]["n"] += 1
        cons[res]["last"] = st["rounds"]
        for o in ops:
            cc = cons.setdefault(o, {"n": 0, "last": 0})
            cc["n"] += 1
            cc["last"] = st["rounds"]
        tfs = st.setdefault("transforms", {})
        tkey = expr + "→" + res
        tf = tfs.setdefault(tkey, {"operands": ops, "result": res, "support": 0, "last": 0})
        tf["support"] += 1
        tf["last"] = st["rounds"]
        rkey = "|".join(sorted([expr, res]))
        r = rels.setdefault(rkey, {"w": 0, "n": 0})
        r["w"] += 2
        r["n"] += 1
        r["last_touch"] = st["rounds"]
        # v9.15 多符号组合节点：表达式本身也是概念，连到每个操作数
        # （"三加二"不再是孤岛规则——它是一个可被思考引用的组合符号）
        cons.setdefault(expr, {"n": 0, "last": 0})
        cons[expr]["n"] += 1
        cons[expr]["last"] = st["rounds"]
        for o in ops:
            rk = "|".join(sorted([expr, o]))
            ro = rels.setdefault(rk, {"w": 0, "n": 0})
            ro["w"] += 1
            ro["n"] += 1
            ro["last_touch"] = st["rounds"]
    for c in top[:3]:
        cc = cons.setdefault(c, {"n": 0, "last": 0})
        cc["n"] += 1
        cc["last"] = st["rounds"]
    for i in range(min(3, len(top))):
        for j in range(i + 1, min(4, len(top))):
            key = "|".join(sorted([top[i], top[j]]))
            r = rels.setdefault(key, {"w": 0, "n": 0})
            r["w"] += 1
            r["n"] += 1
            r["last_touch"] = st["rounds"]  # v9.7a：记录最后同现轮，供记忆巩固裁剪判断
    if len(top) >= 2:
        concl = (title or "").strip()
        if concl:
            pre = sorted([top[0], top[1]])
            rkey = "∧".join(pre) + "→" + concl
            rr = st.setdefault("rules", {}).setdefault(rkey, {
                "premises": pre, "conclusion": concl, "support": 0,
                "confidence": 0.5, "status": "pending", "first": st["rounds"]})
            rr["support"] += 1
    return len(top), sum(1 for _ in rels), len(st.get("rules", {}))


def infer_from_graph(st, topic):
    """v9.7 推理：概念网激活扩散——A 激活，取邻接 C，共同/最强邻接 D → A+C 可能指向未知 D。
    返回 (A, C, D, strength) 或 None。
    v9.12（owner 授权）：前提/候选含格式噪声词（摘要/来源/百度百科…）一律不触发，
    根除"摘要∧来源→信息论"式假推理。"""
    if not topic or topic in _FORMAT_NOISE:
        return None
    rels = st.get("relations", {})
    if len(rels) < 3:
        return None
    # v9.14 错误记忆：曾被判假的前提组合不再触发同类推理
    _bad_pairs = {tuple(m.get("pattern", [])) for m in st.get("mistakes", []) if m.get("pattern")}

    def nbrs(c):
        out = {}
        for k, v in rels.items():
            a, b = k.split("|")
            if b in _FORMAT_NOISE or a in _FORMAT_NOISE:
                continue
            if a == c:
                out[b] = out.get(b, 0) + v["w"]
            elif b == c:
                out[a] = out.get(a, 0) + v["w"]
        return out

    nA = nbrs(topic)
    if not nA:
        return None
    A = topic
    cand = sorted(nA.items(), key=lambda x: -x[1])
    if len(cand) < 2:
        return None
    # v9.14 跳过曾被判假的前提组合 A∧C
    C = None
    for _cc, _ in cand:
        if tuple(sorted([A, _cc])) not in _bad_pairs:
            C = _cc
            break
    if C is None:
        return None
    nC = nbrs(C)
    best, best_s = None, 0
    for d, wa in nA.items():
        if d in (A, C):
            continue
        s = wa + nC.get(d, 0)
        if s > best_s:
            best_s, best = s, d
    if best is None:
        for d, wc in nC.items():
            if d in (A, C):
                continue
            if wc > best_s:
                best_s, best = wc, d
    if best is None or best_s <= 0:
        return None
    return A, C, best, best_s


def transform_compose(st):
    """v9.12（owner 授权）组合泛化/规则链：把已知 transforms 当作改写规则，
    对未见过的加法表达式做符号归约，推出新猜想。不内置算术——
    结果必须由已知规则链归约得到，绝不直接计算。
    例：已知 一加一→二、一加一加一加一→四；
        二加二 → 二展开为(一,一) → 一加一加一加一 → 四。
    返回 (expr, result, via) 或 None。"""
    tfs = st.get("transforms", {})
    if len(tfs) < 2:
        return None
    # 直接表：操作数多重集合（sorted 归一化，加法顺序无关）→ 结果
    direct = {}
    for v in tfs.values():
        ops = tuple(v.get("operands", []))
        if ops and v.get("result"):
            direct[tuple(sorted(ops))] = v["result"]
    # 展开表：结果 → 两操作数展开（最短优先）
    expand = {}
    for ops, res in direct.items():
        if res and len(ops) == 2 and res not in expand:
            expand[res] = ops

    def atoms(x, depth=0):
        """递归把符号展开为原子序列（原子=无展开规则的数字）。"""
        if depth > 6 or x not in expand:
            return (x,)
        out = []
        for sub in expand[x]:
            out.extend(atoms(sub, depth + 1))
        return tuple(out)

    for a in sorted(expand.keys()):
        for b in sorted(expand.keys()):
            ops_key = tuple(sorted([a, b]))
            if ops_key in direct:
                continue  # 已知表达式，不是新猜想
            flat = tuple(sorted(list(atoms(a)) + list(atoms(b))))
            if flat in direct:
                expr = a + "加" + b
                via = (f"{a}={'加'.join(expand[a])}、{b}={'加'.join(expand[b])}，"
                       f"合起来是{'加'.join(flat)}")
                return expr, direct[flat], via
    return None


def do_consolidate_memory(st):
    """v9.7 记忆巩固：重放旧笔记片段（概念再激活）+ 修剪低置信规则/弱关系边。
    夜间权重由节律调制自动抬高。"""
    replayed = 0
    jf = NOTES / "journey.md"
    if jf.exists():
        try:
            lines = [l.strip() for l in jf.read_text(encoding="utf-8", errors="ignore").splitlines() if l.strip()]
            if lines:
                import random as _r
                for _ in range(2):
                    ln = _r.choice(lines)
                    append_note(st, f"- 记忆重放：{ln[:120]}")
                    replayed += 1
        except Exception:
            pass
    # v9.7a修复：首次巩固不修剪（避免 consolidate_round 默认 0 导致 rounds-0>0 误删全部弱边）
    st.setdefault("consolidate_round", st["rounds"])
    # 修剪弱关系：权重 1 且超过 300 轮未再同现（last_touch 由 learn_from_text 更新）
    before_r = len(st.get("relations", {}))
    rm = [k for k, v in st["relations"].items()
          if v["w"] <= 1 and (st["rounds"] - v.get("last_touch", st["rounds"])) > 300]
    for k in rm[:20]:
        del st["relations"][k]
    # 规则：pending 且 support≥3 且轮龄>50 → 统计确认（上限 0.6）；低置信老化 → 删除
    # v9.8：追加低支撑老化回收——pending 且 support≤2 且轮龄>200 的噪音规则（如"大脑回答→QID"）删除
    rm_rules = 0
    for k, v in list(st.get("rules", {}).items()):
        if v["status"] == "pending" and v["support"] >= 3 and (st["rounds"] - v["first"]) > 50:
            v["status"] = "confirmed_stat"; v["confidence"] = min(0.6, v["confidence"] + 0.1)
        elif v["confidence"] < 0.3 and (st["rounds"] - v["first"]) > 30:
            del st["rules"][k]; rm_rules += 1
        elif v["status"] == "pending" and v["support"] <= 2 and (st["rounds"] - v["first"]) > 200:
            del st["rules"][k]; rm_rules += 1
    st["consolidate_round"] = st["rounds"]
    # v9.9 概念层级：长概念包含短概念 → 短为上、长为下（hierarchy），供泛化/迁移
    hier = st.setdefault("hierarchy", {})
    _cs = list(st.get("concepts", {}).keys())
    _added = 0
    for a in _cs:
        if len(a) < 2:
            continue
        for b in _cs:
            if a != b and len(b) >= len(a) + 2 and a in b:
                h = hier.setdefault(a, [])
                if b not in h:
                    h.append(b)
                    _added += 1
                if len(h) > 8:
                    del h[:-8]
        if _added >= 40:
            break
    return True, f"记忆巩固：重放 {replayed} 条、修剪关系 {len(rm)} 条、规则库 {len(st.get('rules', {}))} 条（回收噪音规则 {rm_rules} 条，层级 {_added} 条）"


# ================= v9.8：辉月（记忆回望 · 记忆推理 · 多类型关系）=================
# 关系类型体系：co_occur(共现默认) / causal(因果) / contrast(相反·非) / similar(相似) / temporal(时序)
# owner 2026-10-23 裁定：除因果外加入其他关系（"非"等），让记忆关系更丰富
CONTRAST_PAIRS = [
    ("有序", "无序"), ("秩序", "混沌"), ("信号", "噪声"), ("信息", "噪声"),
    ("确定性", "不确定性"), ("简单", "复杂"), ("局部", "全局"),
    ("微观", "宏观"), ("随机", "规律"), ("吸引", "排斥"),
]


def _rel_nbrs(rels, c):
    """概念 c 的邻接及权重（复制 nbrs 逻辑，独立于推理通道，辉月自用）。"""
    out = {}
    for k, v in rels.items():
        a, b = k.split("|")
        if a == c:
            out[b] = out.get(b, 0) + v.get("w", 0)
        elif b == c:
            out[a] = out.get(a, 0) + v.get("w", 0)
    return out


def do_reflect_memory(st):
    """辉月：回想自己的记忆（重放）+ 对记忆做多类型关系推理建边。
    - causal：confirmed 规则的前提→结论（机制因果）
    - contrast：A、B 的强邻各指向相反词对一方（"非"/对立关系）
    - similar：共享邻居 Jaccard≥0.4（结构相似）
    - temporal：旅程相邻段落概念（先→后，仅对已有边打标）
    每轮小步建边（≤10 条），不改变关系网规模，只标注类型；可回滚（type 字段可清）。"""
    replayed = []
    jf = NOTES / "journey.md"
    if jf.exists():
        try:
            lines = [l.strip() for l in jf.read_text(encoding="utf-8", errors="ignore").splitlines() if l.strip()]
            if lines:
                for _ in range(2):
                    ln = random.choice(lines)
                    replayed.append(ln[:80])
                    append_note(st, f"- 辉月回想：{ln[:120]}")
        except Exception:
            pass
    rels = st.get("relations", {})
    top_edge = None
    if rels:
        top_edge = max(rels.items(), key=lambda kv: kv[1].get("w", 0) if isinstance(kv[1], dict) else 0)
    conf_rules = [v for v in st.get("rules", {}).values() if v.get("status") == "confirmed_stat"]
    if replayed or top_edge or conf_rules:
        _rl = st.setdefault("reflect_log", [])
        _rl.append({
            "round": st["rounds"],
            "what": f"回想{len(replayed)}条；最强边：{top_edge[0] if top_edge else '无'}；确认规则{len(conf_rules)}条",
            "built": {},
        })
        del _rl[:max(0, len(_rl) - 100)]
    built = {"causal": 0, "contrast": 0, "similar": 0, "temporal": 0}
    # ① causal：confirmed 规则 前提→结论——边不存在则补建（辉月推理出因果记忆，
    #    弱边 w=1 标 causal；300 轮不再同现会被记忆巩固弱边裁剪回收，保证可回滚）
    concepts_set = set(st.get("concepts", {}))
    for v in conf_rules:
        prem, concl = v.get("premises", []), v.get("conclusion", "")
        for p in prem:
            if p and concl and p != concl:
                k = "|".join(sorted([p, concl]))
                r = rels.get(k)
                if r is None:
                    if p in concepts_set or concl in concepts_set:
                        rels[k] = {"w": 1, "n": 1, "last_touch": st["rounds"], "type": "causal"}
                        built["causal"] += 1
                        break
                elif r.get("type") in (None, "co_occur"):
                    r["type"] = "causal"; built["causal"] += 1
                    break
    # ② contrast：A 强邻 C1、B 强邻 C2，(C1,C2) 为相反词对 → A|B 标 contrast
    if rels:
        keys = list(rels.keys())
        sample = random.sample(keys, min(6, len(keys)))
        pairset = {(a, b) for a, b in CONTRAST_PAIRS} | {(b, a) for a, b in CONTRAST_PAIRS}
        for k in sample:
            a, b = k.split("|")
            if a == b:
                continue
            na, nb = _rel_nbrs(rels, a), _rel_nbrs(rels, b)
            topa = sorted(na.items(), key=lambda x: -x[1])[:3]
            topb = sorted(nb.items(), key=lambda x: -x[1])[:3]
            hit = False
            for ca, _ in topa:
                for cb, _ in topb:
                    if (ca, cb) in pairset:
                        if rels[k].get("type") in (None, "co_occur"):
                            rels[k]["type"] = "contrast"; built["contrast"] += 1
                        hit = True
                        break
                if hit:
                    break
    # ③ similar：共享邻居 Jaccard ≥ 0.4
    if rels:
        keys = list(rels.keys())
        sample = random.sample(keys, min(8, len(keys)))
        for k in sample:
            a, b = k.split("|")
            if a == b:
                continue
            na, nb = _rel_nbrs(rels, a), _rel_nbrs(rels, b)
            inter = set(na) & set(nb)
            union = set(na) | set(nb)
            if union and len(inter) / len(union) >= 0.4 and len(inter) >= 1:
                if rels[k].get("type") in (None, "co_occur"):
                    rels[k]["type"] = "similar"; built["similar"] += 1
    # ④ temporal：旅程相邻段落的首个高频概念对（先→后），仅对已有边打标
    if jf.exists():
        try:
            segs, cur = [], []
            for l in jf.read_text(encoding="utf-8", errors="ignore").splitlines():
                if l.strip().startswith("##"):
                    if cur:
                        segs.append(" ".join(cur)); cur = []
                cur.append(l.strip())
            if cur:
                segs.append(" ".join(cur))
            cseq = []
            for s in segs:
                w = re.findall(r"[\u4e00-\u9fa5]{2,4}", s)
                if w:
                    cseq.append(Counter(w).most_common(1)[0][0])
            for i in range(min(3, len(cseq) - 1)):
                A, B = cseq[i], cseq[i + 1]
                if A and B and A != B:
                    k = "|".join(sorted([A, B]))
                    if k in rels and rels[k].get("type") in (None, "co_occur"):
                        rels[k]["type"] = "temporal"; built["temporal"] += 1
        except Exception:
            pass
    if st.get("reflect_log"):
        st["reflect_log"][-1]["built"] = built
    dist = Counter(r.get("type", "co_occur") for r in rels.values())
    dist_s = " ".join(f"{t}:{dist.get(t, 0)}" for t in ("co_occur", "causal", "contrast", "similar", "temporal"))
    return True, (f"辉月回望：回想 {len(replayed)} 条记忆、关系标注 {sum(built.values())} 条"
                  f"（因果 {built['causal']} / 相反 {built['contrast']} / 相似 {built['similar']} / 时序 {built['temporal']}）｜关系分布：{dist_s}")



# ================= v9.15：自言自语（内部推理 · 预测闭环 · 多符号组合节点）=================

def do_self_talk(st):
    """自言自语：不读外部文件，从记忆里抽两个相连概念，自己生成一段推理，
    预测下一步会想到什么——这就是大脑离线空转（内部言语）。
    - 命中：两个概念有共同邻居，预测命中 → 边共振加粗
    - 意外：没有共同邻居 → 记 surprise，这就是"想到了没想到的事"
    低能耗（不读外部），疲劳不涨。"""
    rels = st.get("relations", {})
    if len(rels) < 3:
        return False, "记忆太少，还不够自言自语"

    def _nbrs(c):
        out = {}
        for kk, vv in rels.items():
            x, y = kk.split("|")
            if x == c:
                out[y] = out.get(y, 0) + vv.get("w", 0)
            elif y == c:
                out[x] = out.get(x, 0) + vv.get("w", 0)
        return out

    # 抽一条较强的边（权重 top 20 里随机），避免每次抽最冷门的
    keys = sorted(rels.keys(), key=lambda k: -rels[k].get("w", 0))[:20]
    k = random.choice(keys)
    a, b = k.split("|")
    na, nb = _nbrs(a), _nbrs(b)
    common = set(na) & set(nb) - {a, b}

    if common:
        predicted = random.choice(list(common))
        hit = True
        surprise = ""
        # 命中：共同邻居边加粗（思考时共振 → Hebb 式加粗）
        for c in (predicted,):
            for x in (a, b):
                rk = "|".join(sorted([x, c]))
                if rk in rels:
                    rels[rk]["w"] += 1
                    rels[rk]["last_touch"] = st["rounds"]
    else:
        predicted = ""
        hit = False
        all_n = set(na) | set(nb) - {a, b}
        surprise = random.choice(list(all_n)) if all_n else "（无邻接）"

    tl = st.setdefault("self_talk_log", [])
    tl.append({"round": st["rounds"], "pair": [a, b], "predicted": predicted,
               "hit": hit, "surprise": surprise})
    del tl[:-30]

    if hit:
        append_note(st, f"- 自言自语：想到{a}和{b}，猜下一个是{predicted}——猜对了（它们确实共连）")
        return True, f"自言自语：{a}↔{b} → 预测{predicted}（命中，边共振加粗）"
    else:
        append_note(st, f"- 自言自语：想到{a}和{b}，它俩没有共同指向——意外浮现{surprise}")
        return True, f"自言自语：{a}↔{b} → 无共同指向，意外浮现{surprise}"


def run_round(st):
    st["rounds"] += 1
    check_template_retirement(st)
    files, dirs = scan_workspace()
    novelty = novelty_score(files, st)
    action = pick_action(st, st["emotions"], st["web_built"])
    st["action_counts"][action] = st["action_counts"].get(action, 0) + 1
    # v9.8b：渴求度更新——启用动作：选中即重置为 0，未选中按 increment 累加（cap 封顶）
    urge_cfg = _load_ask_config().get("urge", {})
    if urge_cfg.get("enabled", True):
        inc = urge_cfg.get("increment", 1.0)
        cap = urge_cfg.get("cap", 20)
        st.setdefault("urge", {})
        for a in urge_cfg.get("actions", ["reflect_memory", "consolidate_memory"]):
            if a == action:
                st["urge"][a] = 0
            else:
                st["urge"][a] = min(cap, st["urge"].get(a, 0) + inc)

    handlers = {
        "explore_file": do_explore_file,
        "explore_wider": do_explore_wider,
        "visit_new_dir": do_visit_new_dir,
        "tidy_notes": do_tidy_notes,
        "build_site": build_site,
        "refresh_site": refresh_site,
        "ask_brain": do_ask_brain,
        "read_brain": do_read_brain,
        "web_search": do_web_search,
        "consolidate_memory": do_consolidate_memory,   # v9.7
        "reflect_memory": do_reflect_memory,           # v9.8 辉月
        "self_talk": do_self_talk,                     # v9.15 自言自语
        "rest": do_rest,
    }
    args_map = {
        "explore_file": (files, st),
        "visit_new_dir": (dirs, st),
    }
    fn = handlers[action]
    if action in args_map:
        ok, detail = fn(*args_map[action])
    else:
        ok, detail = fn(st)

    # v5：记录动作成功/尝试，供学习调制使用
    stats = st.setdefault("action_stats", {})
    s = stats.setdefault(action, {"ok": 0, "try": 0})
    s["try"] += 1
    if ok:
        s["ok"] += 1
    apply_energy(st, action, ok)   # v9.7：内稳态（耗能/回能/恐惧）

    # v9.5 competence：成功率突破历史新高且 ≥0.5 → "能力提升感"（学会新东西本身就是奖赏）
    comp_triggered = False
    if ok:
        rate = s["ok"] / s["try"]
        cl = st.setdefault("competence", {})
        if rate >= 0.5 and rate > cl.get(action, 0.0):
            cl[action] = rate
            comp_triggered = True

    # v9.4：情绪奖赏表（Q-table 雏形）——行动前后情绪变化写入 mood_reward
    old_e = dict(st["emotions"])
    update_emotions(st, action, novelty, ok)
    if comp_triggered:
        st["emotions"]["satisfaction"] = clamp(st["emotions"]["satisfaction"] + 0.1, 0.0, 1.0)
        st["emotions"]["curiosity"] = clamp(st["emotions"]["curiosity"] + 0.05, 0.0, 1.0)
        detail = detail + f"｜能力里程碑：{action} 成功率 {rate:.0%}"
    new_e = st["emotions"]
    mr = st.setdefault("mood_reward", {})
    m = mr.setdefault(action, {"sat_sum": 0.0, "cur_sum": 0.0, "n": 0})
    m["sat_sum"] += new_e.get("satisfaction", 0.0) - old_e.get("satisfaction", 0.0)
    m["cur_sum"] += new_e.get("curiosity", 0.0) - old_e.get("curiosity", 0.0)
    m["n"] += 1
    log_event(st, action, detail)
    save_state(st)
    SEM.save()   # v6：持久化自编码器参数与语义记忆库
    print(f"[round {st['rounds']}] {action} | { {k: round(v,2) for k,v in st['emotions'].items()} } | {detail}", flush=True)


def main():
    LOGS.mkdir(exist_ok=True)
    st = load_state()
    if ONCE:
        run_round(st)
        return
    print(f"selfdrive agent v9 启动 | 间隔 {INTERVAL}s", flush=True)
    while True:
        try:
            run_round(st)
        except Exception as exc:
            log_event(st, "error", f"异常：{exc}")
            print(f"[error] {exc}", flush=True)
        time.sleep(INTERVAL)


if __name__ == "__main__":
    main()
