        # v9.14 错误记忆：[{round, premises, pattern, result}] 判假前提组合，推理时避开
        "mistakes": [],
        # v9.15：分层预测 + 自言自语 + 多符号组合节点
        "pred_layers": [],       # 分层预测历史 [{"round","file","coarse","fine_expect","hit","surprise"}]
        "self_talk_log": [],     # 自言自语记录
