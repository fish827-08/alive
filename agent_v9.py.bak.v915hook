    },
}


def load_emotions_cfg():
    """读情感配置（brain/emotions.json）；不存在则写默认。"""
    if not EMOTIONS_CFG_FILE.exists():
        try:
            EMOTIONS_CFG_FILE.parent.mkdir(parents=True, exist_ok=True)
            EMOTIONS_CFG_FILE.write_text(
                json.dumps(DEFAULT_EMOTIONS_CFG, ensure_ascii=False, indent=2), encoding="utf-8")
        except Exception:
            pass
        return dict(DEFAULT_EMOTIONS_CFG)
    try:
        data = json.loads(EMOTIONS_CFG_FILE.read_text(encoding="utf-8"))
        return {k: {**dict(DEFAULT_EMOTIONS_CFG.get(k, {})), **v} for k, v in data.items()}
    except Exception:
        return dict(DEFAULT_EMOTIONS_CFG)


def emotion_names():
    return list(load_emotions_cfg().keys())


def default_state():
    emotions = {}
    for ename, cfg in load_emotions_cfg().items():
        emotions[ename] = cfg.get("default", 0.0)
    return {
        "emotions": emotions,
        "visited_files": [], "visited_dirs": [], "wider_files": {},
        "action_counts": {}, "note_lines": 0, "rounds": 0,
        "web_built": False, "web_refreshes": 0,
        "brain_questions": [], "brain_read": [], "last_ask_round": 0,
        "template_uses": {}, "template_prune_round": 0,
        "action_stats": {},   # v5：学习调制（{动作: {ok, try}}）
        # v9.1+：开放求知状态（必须注册进 default，否则重启时 load_state 会丢弃 → 冷却失效）
        "open_asks": 0, "last_open_ask_round": -999, "open_streak": 0,
        # v9.4+：情绪奖赏表（Q-table）与 v9.5 能力里程碑
        "mood_reward": {}, "competence": {},
        # v9.5：Ratchet 式模板退役
        "template_failures": {}, "tpl_pending": {},
        # v9.6：最近读文件的语义中心（内容高频词），提问/搜索主题用，替代裸文件名
        "last_kw": "",
        # v9.7：内稳态 + 关系学习 + 推理（无衰老/死亡：能量可回能、fear 有界）
        "energy": 1.0,
        "concepts": {},        # {概念: {"n": 同现次数, "last": 轮}}
        "relations": {},       # {"A|B": {"w": 边权重, "n": 同现次数}}
        "rules": {},           # {"A∧B→C": {premises, conclusion, support, confidence, status}}
        "infer_log": [],       # [{"qid","premises","result","round"}] 推理提问记录，供 VERDICT 回写
        "last_infer_round": -999,
        "consolidate_round": 0,
        # v9.8 辉月：记忆回望（回想+记忆推理+多类型关系）
        "reflect_log": [],     # [{"round","what","built"}] 辉月回望记录
        "last_reflect_round": -999,
        "urge": {},            # v9.8b 渴求度：{动作: 累积轮数}——低频重要动作越久不触发越想触发
        # v9.8c 预测机制：读文件前预期→读后核对→误差进记忆
        "pred_log": [],        # [{"round","file","expect","hit","miss","surprise","low_value"}]
        # v9.9 注意过滤行为化 + 概念层级
        "hierarchy": {},       # {上位概念: [下位概念...]}
